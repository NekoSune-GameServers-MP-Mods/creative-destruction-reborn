# For a PRIVATE Tailscale or WireGuard IPv4 on your VPS. Do not use public VPS IP.
CDR_VPN_IP=100.88.2.3
CDR_LANGUAGE=en
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CDR_STAFF_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Private account registration gate; generate another independent random secret.
CDR_REGISTRATION_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# 0 = invite-only (recommended); 1 = allow signup without invite via HTTPS.
# Only enable with Cloudflare WAF rate limiting/bot protection for /v1/register.
CDR_PUBLIC_REGISTRATION=0

# Optional host ports for other apps running on the VPS. Container ports remain 8090/8088.
CDR_ACCOUNT_HOST_PORT=8090
CDR_STAFF_HOST_PORT=8088

# Display label only. This does not change Steam server availability/ping.
CDR_ZONE_NAME=Reborn-Dev
